# =========================================================================
# ecommerce-processor — environment configuration
# Copy this file to ".env" and fill in the values.
#   cp .env.example .env        (Git Bash / macOS / Linux)
#   copy .env.example .env      (Windows CMD)
#
# The defaults below are tuned for LOCAL development and work out-of-the-box
# with the included docker-compose.yml (no cloud accounts required).
# =========================================================================

# ---- App ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL (Prisma) ----
# Host port 5433 (mapped in docker-compose to avoid clashing with other DBs).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ecommerce?schema=public"

# ---- Redis (BullMQ) ----
# Host port 6380 (mapped in docker-compose to avoid clashing with other Redis).
REDIS_HOST=localhost
REDIS_PORT=6380
# REDIS_PASSWORD=

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EVENTS_QUEUE=ecommerce_events

# ---- Object storage: MinIO locally (free), real AWS S3 in production ----
# LOCAL DEV (default): keep S3_ENDPOINT as below + MinIO dev credentials.
# PRODUCTION: leave S3_ENDPOINT BLANK and set real AWS keys -> uses real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
S3_BUCKET=product-uploads
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ---- Email (Nodemailer) ----
# LOCAL DEV: leave MAIL_HOST blank -> auto-uses a free Ethereal test inbox.
#            A clickable preview URL is printed in the logs for every email.
# PRODUCTION: fill with a real SMTP provider (AWS SES, Mailtrap, SendGrid...).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="E-commerce Processor <no-reply@example.com>"

# ---- Processing tuning ----
PROCESSING_CONCURRENCY=5
PROCESSING_DB_CHUNK_SIZE=500
PROCESSING_MAX_ATTEMPTS=3
UPLOAD_MAX_MB=25
