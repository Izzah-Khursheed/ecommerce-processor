# =========================================================================
# PRODUCTION environment for the backend (set these on Render, NOT in a file).
# Every value comes from a free-tier provider — see deploy.md for where to click.
# =========================================================================

NODE_ENV=production
# Render injects PORT automatically; leave unset or let the platform set it.

# ---- PostgreSQL (Neon) ----
# Neon dashboard → Connection string (use the pooled "-pooler" URL).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# ---- Redis (Upstash) — TLS URL ----
# Upstash console → your database → "Redis" tab → copy the rediss:// URL.
REDIS_URL="rediss://default:PASSWORD@your-db.upstash.io:6379"

# ---- RabbitMQ (CloudAMQP) — amqps URL ----
# CloudAMQP → your instance → "AMQP details" → copy the URL.
RABBITMQ_URL="amqps://USER:PASSWORD@xxx.rmq.cloudamqp.com/VHOST"
RABBITMQ_EVENTS_QUEUE=ecommerce_events

# ---- Object storage (choose ONE; the app uses the AWS S3 SDK either way) ----
#
# OPTION A — AWS S3 (original design; AWS signup needs a credit card):
#   leave S3_ENDPOINT blank, set S3_FORCE_PATH_STYLE=false, use your IAM keys.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_REGION=us-east-1
S3_BUCKET=product-uploads
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
#
# OPTION B — Supabase Storage (no credit card, S3-compatible). To use it instead:
#   S3_ENDPOINT="https://YOUR_PROJECT.supabase.co/storage/v1/s3"
#   S3_FORCE_PATH_STYLE=true
#   AWS_REGION=<region shown in Supabase>
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY = Supabase S3 access keys

# ---- Email (Brevo SMTP, or Gmail) ----
# Brevo → SMTP & API → SMTP. (Gmail: smtp.gmail.com / 465 / secure=true / App Password.)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=YOUR_BREVO_LOGIN
MAIL_PASSWORD=YOUR_BREVO_SMTP_KEY
MAIL_FROM="Product Processor <you@yourdomain.com>"

# ---- CORS: your deployed frontend URL (from Vercel) ----
FRONTEND_URL=https://your-frontend.vercel.app

# ---- Processing tuning ----
PROCESSING_CONCURRENCY=5
PROCESSING_DB_CHUNK_SIZE=500
PROCESSING_MAX_ATTEMPTS=3
UPLOAD_MAX_MB=25
