# =========================================================================
# PRODUCTION environment for the backend (set these on Render, NOT in a file).
# Every value comes from a free-tier provider — see deploy.md for where to click.
# =========================================================================

NODE_ENV=production
# Render injects PORT automatically; leave unset or let the platform set it.

# ---- PostgreSQL (Neon) ----
# Neon dashboard → Connection string (use the pooled "-pooler" URL).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# ---- Redis (Upstash) — TLS URL ----
# Upstash console → your database → "Redis" tab → copy the rediss:// URL.
REDIS_URL="rediss://default:PASSWORD@your-db.upstash.io:6379"

# ---- RabbitMQ (CloudAMQP) — amqps URL ----
# CloudAMQP → your instance → "AMQP details" → copy the URL.
RABBITMQ_URL="amqps://USER:PASSWORD@xxx.rmq.cloudamqp.com/VHOST"
RABBITMQ_EVENTS_QUEUE=ecommerce_events

# ---- Object storage: Supabase Storage (S3-compatible; the app uses the AWS S3 SDK) ----
# Supabase → Project Settings → Storage: copy the S3 endpoint + region,
# and create an S3 access key (Access key ID + Secret). Bucket = what you created.
S3_ENDPOINT="https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3"
S3_FORCE_PATH_STYLE=true
AWS_REGION=ap-southeast-1
S3_BUCKET=product-uploads
AWS_ACCESS_KEY_ID=YOUR_SUPABASE_S3_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SUPABASE_S3_SECRET_KEY
#
# To switch to real AWS S3 later: blank S3_ENDPOINT, set S3_FORCE_PATH_STYLE=false,
# and use your AWS IAM keys + region. No code change.

# ---- Email ----
# IMPORTANT: Render (and most cloud hosts) BLOCK outbound SMTP ports, so SMTP
# will NOT work in production. Use Brevo's HTTP API instead:
#   Brevo -> SMTP & API -> API Keys -> Create a new API key.
BREVO_API_KEY=YOUR_BREVO_API_KEY
MAIL_FROM="Product Processor <your-verified-brevo-sender>"
#
# (SMTP vars below are only used locally where SMTP isn't blocked; ignored in
#  production when BREVO_API_KEY is set.)
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=YOUR_BREVO_LOGIN
# MAIL_PASSWORD=YOUR_BREVO_SMTP_KEY

# ---- CORS: your deployed frontend URL (from Vercel) ----
FRONTEND_URL=https://your-frontend.vercel.app

# ---- Processing tuning ----
PROCESSING_CONCURRENCY=5
PROCESSING_DB_CHUNK_SIZE=500
PROCESSING_MAX_ATTEMPTS=3
UPLOAD_MAX_MB=25
