# =========================================================================
# OPTIONAL overrides for the LOCAL docker-compose infrastructure.
#
# You do NOT need this file — docker-compose.yml already uses safe local
# defaults. Copy this to ".env" ONLY if you want to change the local
# container credentials. These are for local containers on your machine
# (localhost) and are never used in production.
# =========================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

RABBITMQ_USER=guest
RABBITMQ_PASS=guest

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
